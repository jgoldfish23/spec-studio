# `npm run build:hosted-test` (vite build --mode hosted-test): the hosted build the browser tests run against the fake
# Supabase in tests/e2e/fakeSupabase. These are that fake's address and key, not a real project's. A VITE_SUPABASE_*
# variable already set in the shell takes precedence over this file.
VITE_SUPABASE_URL=http://fake-supabase.test
VITE_SUPABASE_ANON_KEY=test-anon-key
